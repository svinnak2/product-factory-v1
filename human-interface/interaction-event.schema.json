{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Purpose: canonical human-interaction event envelope for all AI-PDLC channels.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "initiative_id",
    "factory_id",
    "timestamp",
    "message"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "initiative_id": {
      "type": "string"
    },
    "factory_id": {
      "type": "string"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
