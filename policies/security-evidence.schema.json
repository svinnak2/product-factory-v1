{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Purpose: validates evidence records used to satisfy AI-PDLC security policy controls.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "control_ids",
    "product_id",
    "artifact_ref",
    "result",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "initiative_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "EXCEPTION"
      ]
    },
    "generated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "details": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    },
    "exception_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
