{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Purpose: validates routing-decision artifacts produced/consumed by the Product Factory.",
  "type": "object",
  "required": [
    "schema_version",
    "routing_decision"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "routing_decision": {
      "type": "object",
      "required": [
        "initiative_id",
        "routes"
      ]
    }
  },
  "additionalProperties": true
}
