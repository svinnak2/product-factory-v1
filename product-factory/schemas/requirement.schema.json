{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Purpose: validates requirement artifacts produced/consumed by the Product Factory.",
  "type": "object",
  "required": [
    "schema_version",
    "requirement"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "requirement": {
      "type": "object",
      "required": [
        "requirement_id",
        "type",
        "description",
        "status"
      ]
    }
  },
  "additionalProperties": true
}
